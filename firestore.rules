rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'isaacfernandoguitar@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isClubMember(clubId) {
      return signedIn() && (
        clubId in ['nintendo', 'arcade', 'rpg'] ||
        (exists(/databases/$(database)/documents/clubs/$(clubId)) &&
         get(/databases/$(database)/documents/clubs/$(clubId)).data.memberIds.hasAny([request.auth.uid]))
      );
    }

    match /users/{userId} {
      allow read: if true; // Perfis públicos para a comunidade
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());

      match /saveStates/{gameId}/slots/{slotId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /cloud_saves/{saveId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /clubs/{clubId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.memberCount == 1;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds.hasAny([request.auth.uid]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isClubMember(clubId);
        allow create: if signedIn()
          && (
            (memberId == request.auth.uid && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.memberIds.hasAny([request.auth.uid])) ||
            get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid
          );
        allow update: if signedIn()
          && (memberId == request.auth.uid || get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
        allow delete: if signedIn()
          && (memberId == request.auth.uid || get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
      }

      match /requests/{requestId} {
        allow read: if signedIn() && (requestId == request.auth.uid || get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
        allow create: if signedIn() && requestId == request.auth.uid;
        allow delete: if signedIn() && (requestId == request.auth.uid || get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
      }

      match /games/{gameId}/checkpoints/{checkpointId} {
        allow read: if isClubMember(clubId);
        allow create: if isClubMember(clubId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80;
        allow update, delete: if isClubMember(clubId)
          && resource.data.userId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if isClubMember(clubId);
        allow create: if isClubMember(clubId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false; // Chat messages cannot be edited/deleted for now
      }

      match /presence/{userId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == userId;
      }

      match /votes/{voteId} {
        allow read: if isClubMember(clubId);
        allow create, update: if isClubMember(clubId) && request.auth.uid == voteId;
        allow delete: if isClubMember(clubId) && (request.auth.uid == voteId || get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid);
      }
    }

    match /game_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.memberIds.hasAny([request.auth.uid]) ||
        isAdmin()
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /members/{memberId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn();
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if isAdmin();
      }

      match /presence/{userId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == userId;
      }

      match /signaling/{peerId} {
        allow read, write: if signedIn();
      }

      match /voice_peers/{peerId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }

      match /voice_signals/{signalId} {
        allow read, write: if signedIn();
      }

      match /checkpoints/{checkpointId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn();
      }
    }
    
    match /activities/{activityId} {
      allow read: if true; // Feed is global/public
      allow create: if signedIn();
      allow update: if signedIn(); // Curtidas, reações e contador de comentários
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /game_tips/{tipId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn(); // Curtidas no mural de dicas
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /follows/{followId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource == null || 
        resource.data.senderId == request.auth.uid || 
        resource.data.targetUserId == request.auth.uid
      );
    }

    match /shelves/{userId} {
      allow read: if true; // Estantes de jogos são públicas para visualização de outros jogadores
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /blocks/{blockId} {
      allow read, write: if signedIn();
    }

    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /admin_config/{configId} {
      allow read: if true; // Avisos e Desafios Globais são públicos
      allow write: if isAdmin(); // Apenas administradores configuram
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /conversations/{convId} {
      allow read: if signedIn() && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if signedIn() && request.resource.data.participantIds.hasAny([request.auth.uid]);
      allow update: if signedIn() && resource.data.participantIds.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds.hasAny([request.auth.uid]);
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds.hasAny([request.auth.uid]);
      }
    }
  }
}
